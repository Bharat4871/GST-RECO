digraph ER { rankdir=LR; node [shape=plaintext, fontname="Helvetica", fontsize=9]; edge [fontname="Helvetica", fontsize=8, color="#445468", arrowhead=crow, arrowtail=tee, dir=both];
  client [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1d4d9c"><font color="white"><b>CLIENT</b></font></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">name, gstin, pan</td></tr><tr><td align="left">state, nature, filing</td></tr><tr><td align="left">has_exempt</td></tr></table>>];
  vendor [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1d4d9c"><font color="white"><b>VENDOR</b></font></td></tr><tr><td align="left">PK id · FK client_id</td></tr><tr><td align="left">name, gstin, type</td></tr><tr><td align="left">status, cancel_date</td></tr><tr><td align="left">gstr1_rate, gstr3b_rate</td></tr></table>>];
  purchase [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1d4d9c"><font color="white"><b>PURCHASE</b></font></td></tr><tr><td align="left">PK id · FK client_id, vendor_id</td></tr><tr><td align="left">invoice_no, invoice_date</td></tr><tr><td align="left">hsn_sac, taxable, rate, igst/cgst/sgst</td></tr><tr><td align="left">reverse_charge, rcm_type, rcm_paid_date</td></tr><tr><td align="left">usage, itc_claimed, claim_period</td></tr></table>>];
  gstr2b [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1d4d9c"><font color="white"><b>GSTR2B</b></font></td></tr><tr><td align="left">PK id · FK client_id</td></tr><tr><td align="left">return_period, supplier_gstin</td></tr><tr><td align="left">invoice_no, taxable, taxes</td></tr><tr><td align="left">itc_available, ims_action</td></tr></table>>];
  sales [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1d4d9c"><font color="white"><b>SALES_SUMMARY</b></font></td></tr><tr><td align="left">PK (client_id, period)</td></tr><tr><td align="left">taxable, zero_rated, exempt</td></tr><tr><td align="left">output IGST/CGST/SGST</td></tr></table>>];
  recon [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#a96c12"><font color="white"><b>RECON_RESULT</b></font></td></tr><tr><td align="left">pr_id → PURCHASE</td></tr><tr><td align="left">b2b_id → GSTR2B</td></tr><tr><td align="left">status, confidence, note</td></tr></table>>];
  itc [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#a96c12"><font color="white"><b>ITC_EVALUATION</b></font></td></tr><tr><td align="left">PK/FK id → PURCHASE</td></tr><tr><td align="left">status, eligible, blocked</td></tr><tr><td align="left">at_risk, lapsed, flags_json</td></tr></table>>];
  client -> vendor [label="1 : N"]; client -> purchase [label="1 : N"]; client -> gstr2b [label="1 : N"]; client -> sales [label="1 : N"];
  vendor -> purchase [label="1 : N"]; purchase -> recon [label="1 : 0..1"]; gstr2b -> recon [label="1 : 0..1"]; purchase -> itc [label="1 : 1", arrowhead=tee];
}
