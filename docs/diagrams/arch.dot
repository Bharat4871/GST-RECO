digraph A { rankdir=TB; compound=true; node [fontname="Helvetica", fontsize=9, shape=box, style="rounded,filled", fillcolor="white", color="#445468"]; edge [color="#445468", fontname="Helvetica", fontsize=8];
  subgraph cluster_ui { label="Presentation - HTML5 / CSS3 / JavaScript (runs offline)"; fontname="Helvetica"; fontsize=10; style="rounded,filled"; fillcolor="#e2eaf7"; color="#1d4d9c";
    ui1 [label="20 views: dashboard, registers,\nrecon, ITC, RCM, 3B, AI lab..."]; ui2 [label="Import / export\n(CSV, Excel, JSON, portal 2B)"]; ui3 [label="Charts (Chart.js)\nExcel (SheetJS)"]; }
  subgraph cluster_js { label="Browser engines - JavaScript"; fontname="Helvetica"; fontsize=10; style="rounded,filled"; fillcolor="#f8ecd6"; color="#a96c12";
    j1 [label="core.js\ndates, GSTIN"]; j2 [label="engine.js\nrecon, ITC, RCM, 3B"]; j3 [label="ai.js\nNaive Bayes, Isolation Forest,\nBenford, risk, chatbot"]; }
  subgraph cluster_kb { label="Shared knowledge base - JSON"; fontname="Helvetica"; fontsize=10; style="rounded,filled"; fillcolor="#ebe8f8"; color="#5b4bb0";
    kb [label="gst_knowledge.json\n23 RCM entries · 11 blocked heads\n294 training sentences · case laws"]; }
  subgraph cluster_py { label="Python engine (optional) - Flask REST API"; fontname="Helvetica"; fontsize=10; style="rounded,filled"; fillcolor="#e0f1e7"; color="#17763f";
    p1 [label="recon / itc / rcm /\nreturns engines"]; p2 [label="ai_engine.py\nscikit-learn"]; p3 [label="report_generator.py\nopenpyxl MIS"]; p4 [label="SQLite + SQL views\n14 analytical queries"]; }
  subgraph cluster_off { label="Office tools"; fontname="Helvetica"; fontsize=10; style="rounded,filled"; fillcolor="#f3f5f8"; color="#6f7d90";
    x1 [label="Excel working model\n1,281 formulas"]; x2 [label="VBA macros & UDFs"]; x3 [label="Jupyter notebook"]; }
  ui1 -> j2 [lhead=cluster_js]; j2 -> kb [lhead=cluster_kb]; p1 -> kb [lhead=cluster_kb]; ui1 -> p1 [label="fetch /api (if linked)", lhead=cluster_py, style=dashed]; p1 -> x1 [lhead=cluster_off, style=dotted, label="same rules"];
}
